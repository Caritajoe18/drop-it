{
  "name": "drop-it-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Drop-It backend API — Express, TypeScript, Sequelize, Hedera USDC payments",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "compile": "tsc --w",
    "start": "node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "test": "jest --passWithNoTests",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "db:seed:all": "npx sequelize-cli db:seed:all",
    "db:seed:one": "npx sequelize-cli db:seed:one --seed",
    "db:seed:undo": "npx sequelize-cli db:seed:undo",
    "db:seed:undo:all": "npx sequelize-cli db:seed:undo:all",
    "db:migrate:status": "npx sequelize-cli db:migrate:status",
    "db:seed:status": "npx sequelize-cli db:seed:status",
    "db:migrate:generate": "npx sequelize-cli migration:generate --name"
    
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.46.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.2.0",
    "ts-node-dev": "^2.0.0",
    "sequelize-cli": "^6.6.2",
    "typescript": "^5.5.0"
  }
}
